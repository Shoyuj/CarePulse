# ==============================================================================
# Healthcare Appointment & Follow-up Manager - Environment Variables Template
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=h2 # Set to 'postgres' for production/docker

# PostgreSQL Database (Required if SPRING_PROFILES_ACTIVE=postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/healthcare_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# JWT Security (Generate a secure 256-bit / 32-byte secret in production)
JWT_SECRET=your_secure_256_bit_jwt_secret_here_min_32_characters
JWT_EXPIRATION_MS=86400000

# Google Gemini AI API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RATE_LIMIT_ENABLED=true
GEMINI_RPM_LIMIT=15
GEMINI_DAILY_QUOTA=500
GEMINI_USER_HOURLY_LIMIT=10

# Email Notification Service (SMTP / Nodemailer / SendGrid)
MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_username
SPRING_MAIL_PASSWORD=your_smtp_password
MAIL_FROM=noreply@carepulse-dehradun.in

# Google Calendar API (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Frontend URL (For CORS and redirect links)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
